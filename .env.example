# Cluster / infrastructure
OCI_REGION=me-jeddah-1
OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..example
KUBECONFIG=/path/to/kubeconfig

# Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# LLM / AI configuration
# For local Ollama, set LLM_PROVIDER=ollama and point LLM_API_BASE at the internal IP/URL of the
# Ollama VM (no Cloudflare proxy). For OpenAI, set LLM_PROVIDER=openai and configure the OpenAI
# variables as usual.
LLM_PROVIDER=ollama            # Valid values: "ollama" or "openai"
LLM_MODEL=qwen2:7b             # Model name passed to Ollama or OpenAI
LLM_API_BASE=http://192.168.8.157:11434  # Direct URL to the Ollama instance on the local network; do not proxy via Cloudflare (avoids 524 errors)
LLM_TIMEOUT_SECONDS=90         # Read timeout for LLM HTTP requests (seconds)

# OpenAI-specific configuration (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=<your-openai-key-here>
OPENAI_BASE_URL=https://api.openai.com/v1

# Mode configuration
SILKY_MODE=chat
NIGHT_INTERVAL_SECONDS=300
SILKY_SKIP_CONTEXT_COLLECTION=false
