# Cluster / infrastructure
OCI_REGION=me-jeddah-1
OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..example
KUBECONFIG=/path/to/kubeconfig

# Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# LLM / AI configuration
# Choose one of the modes below by setting LLM_PROVIDER and the matching base URL variables.
LLM_TIMEOUT_SECONDS=90         # Read timeout for LLM HTTP requests (applies to both providers).

# OpenAI or OpenAI-compatible (including local Ollama/LM Studio)
LLM_PROVIDER=openai            # Valid values: "openai" or "ollama"
LLM_MODEL=qwen3:32b            # Example model name for OpenAI or OpenAI-compatible servers
OPENAI_API_KEY=your-key-here   # For local OpenAI-compatible servers, this can be a dummy value if auth is not enforced
OPENAI_BASE_URL=https://api.openai.com/v1  # Default OpenAI endpoint. Override when pointing at another OpenAI-compatible server.
LLM_API_BASE=http://localhost:11434  # Optional base for Ollama when using the OpenAI-compatible API. Silky Sentinel will call <LLM_API_BASE>/v1.

# Mode configuration
SILKY_MODE=chat
NIGHT_INTERVAL_SECONDS=300
SILKY_SKIP_CONTEXT_COLLECTION=false
