# Cluster / infrastructure
OCI_REGION=me-jeddah-1
OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..example
KUBECONFIG=/path/to/kubeconfig

# Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# LLM / AI configuration
# Choose one of the modes below by setting LLM_PROVIDER and the matching base URL variables.
LLM_TIMEOUT_SECONDS=90         # Read timeout for LLM HTTP requests (applies to both providers).

# Mode 1: OpenAI or OpenAI-compatible (including local Ollama/LM Studio)
LLM_PROVIDER=openai            # Valid values: "openai" or "ollama"
LLM_MODEL=qwen3:32b            # Example model name for OpenAI or OpenAI-compatible servers
OPENAI_API_KEY=your-key-here   # For some local OpenAI-compatible servers, this can be a dummy value if auth is not enforced
OPENAI_BASE_URL=https://api.openai.com/v1  # Default OpenAI endpoint. For a local Ollama/LM Studio OpenAI-compatible endpoint, change to something like http://192.168.8.123:11434/v1.

# Mode 2: Native Ollama /api/generate
LLM_PROVIDER=ollama            # Switch to this provider to use the native Ollama /api/generate endpoint
LLM_MODEL=qwen3:32b            # Example model name for native Ollama
LLM_API_BASE=http://localhost:11434  # Base URL must not include /api; Silky Sentinel will call /api/generate on this base. Point this directly at the Ollama server on your local network.

# Mode configuration
SILKY_MODE=chat
NIGHT_INTERVAL_SECONDS=300
SILKY_SKIP_CONTEXT_COLLECTION=false
